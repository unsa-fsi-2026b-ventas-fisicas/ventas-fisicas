# Copiar este archivo a .env y ajustar los valores (NO subir .env al repositorio)

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-propia-solo-desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
DB_NAME=ventas_fisicas
