# ============================================================
#  Variables de entorno del backend
#  Copia este archivo como ".env" y ajusta los valores:
#      cp .env.example .env
#  El archivo ".env" NO se sube a GitHub (contiene secretos).
# ============================================================

# Puerto donde escucha la API
PORT=3001

# Conexion a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ventas_fisicas

# Clave secreta para firmar los tokens JWT.
# En produccion debe ser larga y secreta; para el aula sirve cualquiera.
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta
JWT_EXPIRA=8h
