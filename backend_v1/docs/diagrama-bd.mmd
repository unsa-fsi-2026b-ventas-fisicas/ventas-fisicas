    SUCURSALES {
        int id PK
        varchar nombre
        varchar direccion
        boolean activo
    }

    USUARIOS {
        int id PK
        varchar nombre
        varchar usuario UK
        varchar password_hash
        varchar rol
        int sucursal_id FK
        boolean activo
    }

    PRODUCTOS {
        int id PK
        varchar codigo_barras UK
        varchar nombre
        varchar categoria
        numeric precio_venta
        numeric costo
        boolean afecto_igv
        boolean activo
    }

    INVENTARIO {
        int producto_id PK_FK
        int sucursal_id PK_FK
        int stock
        int stock_minimo
    }

    CLIENTES {
        int id PK
        varchar tipo_documento
        varchar numero_documento UK
        varchar nombre
        varchar telefono
    }

    CAJAS {
        int id PK
        int usuario_id FK
        int sucursal_id FK
        numeric monto_inicial
        varchar estado
        numeric total_esperado
        numeric monto_contado
        numeric diferencia
    }

    CORRELATIVOS {
        varchar tipo_comprobante PK
        varchar serie PK
        int ultimo_numero
    }

    VENTAS {
        int id PK
        varchar tipo_comprobante
        varchar serie
        int numero
        int cliente_id FK
        int usuario_id FK
        int caja_id FK
        int sucursal_id FK
        numeric subtotal
        numeric igv
        numeric total
        numeric total_devuelto
        numeric vuelto
        varchar estado
    }

    VENTA_DETALLE {
        int id PK
        int venta_id FK
        int producto_id FK
        int cantidad
        numeric precio_unitario
        numeric total_linea
        boolean afecto_igv
        int cantidad_devuelta
    }

    PAGOS {
        int id PK
        int venta_id FK
        varchar metodo
        numeric monto
    }

    DEVOLUCIONES {
        int id PK
        int venta_id FK
        int usuario_id FK
        varchar motivo
        varchar metodo
        numeric total
    }

    DEVOLUCION_DETALLE {
        int id PK
        int devolucion_id FK
        int venta_detalle_id FK
        int cantidad
        numeric monto
    }
